# Loaded instead of .env whenever APP_ENV=testing (phpunit.xml sets it).
# Committed on purpose: contains no real secrets. Never point this at the dev/prod database —
# tests use RefreshDatabase and wipe whatever database they connect to.
APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:Br3ehRq+ev37LFB9gs7TlTv+ud4zXJCLwPPBQAf6Hwc=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Dummy values — all Xendit HTTP calls are faked with Http::fake in tests.
XENDIT_SECRET_KEY=xnd_development_testing_key
XENDIT_CALLBACK_TOKEN=testing-callback-token
XENDIT_BASE_URL=https://api.xendit.co
